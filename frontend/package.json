{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vueuse/core": "^14.2.1",
    "@zxing/browser": "^0.2.1",
    "laravel-echo": "^2.6.3",
    "pinia": "^3.0.4",
    "pusher-js": "^8.6.0",
    "tailwindcss": "^4.2.1",
    "vue": "^3.5.29",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.4.22",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.6",
    "@types/node": "^24.11.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.93.0",
    "eslint-plugin-vue": "~10.12.1",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.93.0",
    "prettier": "3.10.1",
    "sass-embedded": "^1.108.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-checker": "^0.12.0",
    "vite-plugin-pwa": "^1.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^14.0.2"
